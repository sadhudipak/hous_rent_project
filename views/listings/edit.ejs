<% layout('/layouts/boilerplate') %><body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Edit Your Listing</h3>
            <form novalidate class="needs-validation" method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data"> 
                 <!-- Ensure this is present -->
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" type="text" value="<%= listing.title %>" class="form-control" id="title"required>
                    <div class="invalid-feedback">
                        Enter Title
                    </div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]"class="form-control" id="description"required><%= listing.description %></textarea>
                    <div class="invalid-feedback">
                        Enter Discription
                    </div>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Image URL</label>
                    <input name="listing[image]" type="file" class="form-control" id="image">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]"value="<%= listing.price %>"class="form-control" id="price"required>
                        <div class="invalid-feedback">
                          Enter valid Price
                        </div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" type="text" value="<%= listing.country %>"class="form-control" id="country"required>
                        <div class="invalid-feedback">
                            Enter Countery Name
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" type="text" value="<%= listing.location %>" class="form-control" id="location"required>
                    <div class="invalid-feedback">
                         Enter Location 
                    </div>
                </div>
                <button class="btn btn-dark edit-btn mb-3">Edit</button>
                <br>
            </form>
        </div>
    </div>
</body>

