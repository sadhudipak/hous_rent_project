<% layout('/layouts/boilerplate') %>
<body>
    <div class="row mb-3">
        <div class="col-12 col-md-8 offset-md-2">
            <br><br>
            <h3>Create a New listing</h3>
            <form  method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" type="text" placeholder="Add a catchy title" class="form-control" id="title" required>
                    <div class="invalid-feedback">
                        Enter Title
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" id="description" required></textarea>
                    <div class="invalid-feedback">
                        Enter Discription
                    </div>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input name="listing[image]" type="file"class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-12 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" type="number" placeholder="12000" class="form-control" id="price" required>
                        <div class="invalid-feedback">
                            Enter Price
                        </div>
                    </div>
                    
                    <div class="mb-3 col-12 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" type="text" placeholder="India" class="form-control" id="country" required>
                        <div class="invalid-feedback">
                            Enter Country Name
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" type="text" placeholder="Patan, Gujrat" class="form-control" id="location" required>
                    <div class="invalid-feedback">
                        Enter Location
                    </div>
                </div>
                <button class="btn btn-dark add-btn mt-3">Add</button>
                <br><br>
            </form>
        </div>
    </div>
</body>
