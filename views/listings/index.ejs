<% layout('/layouts/boilerplate') %>
<!-- Filter-bar styling lives in /css/responsive.css so mobile rules always win -->
<!-- <h3 class="mt-3">All listings</h3> -->
 <div id="filters">
    <div class="filter mb-3">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Icomic cities</p>
    </div>
      <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Montains</p>
    </div>
      <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>
 </div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3">
    <% for(let listings of allListings){ %>
        <a href="/listings/<%= listings._id %>" class="listing-links">
            <div class="card col listing-card">
                <img 
                    src="<%= listings.image.url %>"
                    class="card-img-top card-img" 
                    alt="listing_image" 
                />
                <div class="card-img-overlay">
                    <i class="fa-solid fa-heart"></i>
                </div>
                <div class="card-body">
                <p class="card-text">
                    <b><%= listings.title %> </b><br>
                    &#8377; <%= listings.price.toLocaleString("en-IN")%>/night
                    <!--  toLocaleString("en-IN")%>/night -->
                   </p>
                </div>
            </div>
        </a>
    <%}%>
</div>
